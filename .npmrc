# Versiones exactas siempre (sin ^ ni ~)
save-exact=true
# Falla si la versión de Node o pnpm no coincide con package.json
engine-strict=true
# No instalar paquetes publicados hace menos de 24 h (defensa contra paquetes maliciosos recién publicados)
minimum-release-age=1440
# pnpm 10 no ejecuta scripts de instalación de dependencias salvo los autorizados
